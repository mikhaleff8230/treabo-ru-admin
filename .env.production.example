# Marvel admin API lives on api.* (Laravel routes: /token, /me, … without /api prefix)
NEXT_PUBLIC_REST_API_ENDPOINT=https://api.treabo.md
NEXT_PUBLIC_API_URL=https://api.treabo.md
NEXT_PUBLIC_SHOP_URL=https://treabo.md
NEXT_PUBLIC_AUTH_TOKEN_KEY=AUTH_CRED

# Proffi /api/admin/* — set same value as PROFFI_ADMIN_TOKEN in pixer-api .env (or enter on login)
NEXT_PUBLIC_PROFFI_ADMIN_TOKEN=

NEXT_PUBLIC_DEFAULT_LANGUAGE=ru
NEXT_PUBLIC_ENABLE_MULTI_LANG=false
NEXT_PUBLIC_AVAILABLE_LANGUAGES=ru

APPLICATION_MODE=production
